{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNCERTAIN"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {"type": "string"},
          "reason": {"type": "string"},
          "counterexample": {"type": "string"}
        },
        "required": ["claim", "reason", "counterexample"],
        "additionalProperties": false
      }
    }
  },
  "required": ["status", "checks", "issues"],
  "additionalProperties": false
}
